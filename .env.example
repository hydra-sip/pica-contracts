# Copiar a .env y completar. El .env no se commitea.
# La clave privada del deployer NO va acá: se importa en un keystore cifrado de Foundry
# (cast wallet import deployer --interactive) y se usa con --account deployer.

# RPC de Base Sepolia (por ejemplo, https://sepolia.base.org o el de un proveedor)
BASE_SEPOLIA_RPC_URL=

# API key v2 de Etherscan (sirve para verificar en BaseScan)
ETHERSCAN_API_KEY=

# Dueño inicial del contrato. Si se deja vacío o se borra, el dueño es la cuenta que despliega.
OWNER=
